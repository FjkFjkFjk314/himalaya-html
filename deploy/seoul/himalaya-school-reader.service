[Unit]
Description=Himalaya read-only mail frontend
After=network-online.target
Wants=network-online.target

[Service]
User=himalaya-reader
Group=himalaya-reader
WorkingDirectory=/srv/himalaya-mail/current/deploy/reader
EnvironmentFile=/srv/himalaya-mail/shared/reader.env
RuntimeDirectory=himalaya-mail-reader
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/rm -f /run/himalaya-mail-reader/reader.sock
ExecStart=/usr/bin/python3 -B /srv/himalaya-mail/current/deploy/reader/reader.py --unix-socket /run/himalaya-mail-reader/reader.sock
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
